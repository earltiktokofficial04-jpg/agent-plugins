#############################################################################
#                                                                           #
#   PTERODACTYL AUTO-INSTALLER — FAIL CONFIG (OPSIONAL)                     #
#                                                                           #
#   KAU TIDAK PERLUKAN FAIL INI untuk pemasangan biasa.                     #
#   Jalankan `sudo ./install.sh` sahaja — ia akan tanya beberapa soalan      #
#   dan mengesan yang lain sendiri.                                          #
#                                                                           #
#   Fail ini untuk pemasangan tanpa pengawasan (CI, banyak server):          #
#       sudo ./install.sh --config pterodactyl.conf --non-interactive        #
#                                                                           #
#   Hanya PANEL_FQDN dan ADMIN_EMAIL yang benar-benar wajib. Semua yang      #
#   lain ada default atau dikesan automatik — biar kosong kalau tak pasti.   #
#                                                                           #
#   Format: KEY="value"  — jangan buang tanda petik.                        #
#   Semak tanpa memasang:  sudo ./install.sh --config <fail> --dry-run       #
#                                                                           #
#############################################################################


#============================================================================
#  WAJIB
#============================================================================

# WAJIB. Domain atau IP untuk akses panel. Contoh: "panel.domain.com" atau "203.0.113.10"
# Domain diperlukan kalau kau mahu HTTPS; IP tidak boleh dapat sijil Let's Encrypt.
PANEL_FQDN=""

# WAJIB. Email akaun admin pertama.
ADMIN_EMAIL=""
#============================================================================
#  OPSIONAL — semuanya boleh biar kosong
#============================================================================

# OPSIONAL — default: "admin"
ADMIN_USERNAME=""

# OPSIONAL — default: dijana automatik dan dipaparkan pada penghujung.
# Kalau diisi: minimum 8 aksara, mesti ada huruf besar, huruf kecil dan nombor.
ADMIN_PASSWORD=""

# OPSIONAL — default: dikesan daripada zon waktu sistem.
# Contoh: "Asia/Kuala_Lumpur", "Asia/Jakarta", "UTC"
PANEL_TIMEZONE=""


# OPSIONAL — default: ADMIN_EMAIL. Email pendaftaran Let's Encrypt.
SSL_EMAIL=""

# OPSIONAL — default: PANEL_FQDN. Domain/IP node tempat game server berjalan.
WINGS_FQDN=""

# OPSIONAL — default: hostname mesin ini.
NODE_NAME=""

# OPSIONAL — default: "main". Kod lokasi pendek.
NODE_LOCATION=""

#--- Panel -----------------------------------------------------------------

# OPSIONAL — default: "no" untuk IP, ditanya untuk domain
# "yes" = pasang sijil Let's Encrypt automatik (perlu domain sebenar + port 80 terbuka).
# "no"  = HTTP kosong sahaja.
PANEL_SSL=""

# OPSIONAL — default: "80" (atau "443" bila PANEL_SSL="yes")
# Port nginx untuk panel. Tukar kalau port 80 dah diguna benda lain.
PANEL_HTTP_PORT=""

# OPSIONAL — default: "Admin"
ADMIN_FIRST_NAME=""

# OPSIONAL — default: "User"
ADMIN_LAST_NAME=""

# OPSIONAL — default: "no"
# "yes" = benarkan Pterodactyl hantar data telemetri anonim ke upstream.
PANEL_TELEMETRY=""

# OPSIONAL — default: "yes". Pasang Node.js LTS.
INSTALL_NODEJS=""

# OPSIONAL — default: "yes". Pasang Python 3 + pip + venv.
INSTALL_PYTHON=""

# OPSIONAL — default: "22". Versi major Node.js.
NODEJS_MAJOR=""

# OPSIONAL — default: "no"
# "yes" = hidupkan reCAPTCHA di halaman login (perlu RECAPTCHA_SITE_KEY + SECRET_KEY).
RECAPTCHA_ENABLED=""

# OPSIONAL — hanya diguna bila RECAPTCHA_ENABLED="yes"
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

#--- Pangkalan data --------------------------------------------------------

# OPSIONAL — default: "panel"
DB_NAME=""

# OPSIONAL — default: "pterodactyl"
DB_USERNAME=""

# OPSIONAL — default: dijana rawak 32 aksara (disimpan dalam fail kredential)
DB_PASSWORD=""

# OPSIONAL — default: "127.0.0.1"
DB_HOST=""

# OPSIONAL — default: "3306"
DB_PORT=""

#--- Redis -----------------------------------------------------------------

# OPSIONAL — default: "127.0.0.1"
REDIS_HOST=""

# OPSIONAL — default: "6379"
REDIS_PORT=""

# OPSIONAL — default: kosong (tiada password, Redis bind ke localhost sahaja)
REDIS_PASSWORD=""

#--- Email keluar ----------------------------------------------------------

# OPSIONAL — default: "log"
# Pilihan: "log" (tulis ke fail, tiada email betul dihantar) atau "smtp".
# Guna "smtp" kalau nak panel boleh hantar email reset password.
MAIL_DRIVER=""

# OPSIONAL — WAJIB JIKA MAIL_DRIVER="smtp"
MAIL_HOST=""
MAIL_PORT=""
MAIL_USERNAME=""
MAIL_PASSWORD=""

# OPSIONAL — default: "no-reply@<PANEL_FQDN>"
MAIL_FROM=""

# OPSIONAL — default: "Pterodactyl Panel"
MAIL_FROM_NAME=""

# OPSIONAL — default: "tls". Pilihan: "tls", "ssl", "none"
MAIL_ENCRYPTION=""

#--- Wings / Node ----------------------------------------------------------

# OPSIONAL — default: "yes"
# "no" = pasang panel sahaja, langkau Wings/Docker/node sepenuhnya.
INSTALL_WINGS=""

# OPSIONAL — default: nama panjang sama dengan NODE_LOCATION
NODE_LOCATION_DESC=""

# OPSIONAL — default: auto-detect (jumlah RAM fizikal - 1024MB)
# Jumlah RAM dalam MB yang node ni boleh agihkan kepada game server.
NODE_MEMORY=""

# OPSIONAL — default: auto-detect (ruang kosong pada / dalam MB - 5120MB)
NODE_DISK=""

# OPSIONAL — default: "0". Peratus over-allocate RAM. "-1" = tanpa had.
NODE_MEMORY_OVERALLOCATE=""

# OPSIONAL — default: "0". Peratus over-allocate disk. "-1" = tanpa had.
NODE_DISK_OVERALLOCATE=""

# OPSIONAL — default: "8080". Port Wings mendengar (HTTP daemon).
WINGS_PORT=""

# OPSIONAL — default: "2022". Port SFTP Wings.
WINGS_SFTP_PORT=""

# OPSIONAL — default: "/var/lib/pterodactyl/volumes"
WINGS_DATA_DIR=""

# OPSIONAL — default: sama dengan PANEL_SSL
# "yes" = node guna https untuk cakap dengan panel. Perlu WINGS_FQDN jadi domain sebenar.
WINGS_SSL=""

# OPSIONAL — default: "25565-25585"
# Julat port game yang akan didaftarkan sebagai allocation. Format: "mula-tamat"
# Contoh lain: "25565-25600" atau "27015-27030"
NODE_PORT_RANGE=""

# OPSIONAL — default: "0.0.0.0"
# IP yang allocation akan didaftarkan pada. Biar default kalau tak pasti.
NODE_ALLOCATION_IP=""

# OPSIONAL — default: auto-pilih julat 172.x yang kosong
# Julat rangkaian Docker untuk Wings. Wings guna 172.18.0.0/16 secara default;
# kalau julat itu sudah dipakai, Wings mati dengan "Pool overlaps". Script akan
# auto-pilih julat kosong, tapi kau boleh paksa satu di sini.
# Contoh: "172.25.0.0/16"
WINGS_DOCKER_SUBNET=""

#--- Egg tambahan ----------------------------------------------------------

# OPSIONAL — default: kosong
# Egg rasmi (Minecraft, Rust, Source, dll) SENTIASA dipasang automatik.
# Ini untuk egg custom tambahan. Senaraikan URL fail .json, pisah dengan koma.
# Contoh: "https://contoh.com/egg-a.json,https://contoh.com/egg-b.json"
EGG_IMPORT_URLS=""

# OPSIONAL — default: "1"
# ID nest tempat egg custom di atas akan diletak.
EGG_IMPORT_NEST_ID=""

#--- Lain-lain -------------------------------------------------------------

# OPSIONAL — default: kosong
# Token GitHub (classic, tanpa perlu apa-apa skop). Isi ini kalau composer gagal
# dengan ralat "Could not authenticate against github.com" atau "API rate limit".
# GitHub hadkan muat turun tanpa token, dan pada VPS yang IP-nya dikongsi had itu
# selalu kena. Jana di: https://github.com/settings/tokens
GITHUB_TOKEN=""

# OPSIONAL — default: "no"
# "yes" = pasang fail2ban + tetapkan UFW (buka 22, port panel, port wings, julat game).
HARDEN_FIREWALL=""

# OPSIONAL — default: "/root/pterodactyl-credentials.txt"
# Fail tempat semua password yang dijana disimpan (chmod 600).
CREDENTIALS_FILE=""
